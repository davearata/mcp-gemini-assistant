# Copy this to .env and add your actual API key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Use a different model (default: gemini-2.5-pro)
# GEMINI_MODEL=gemini-2.5-pro

# Optional: Custom system prompt for Gemini behavior
# SYSTEM_PROMPT="Your custom system prompt here..."

# ── SSE / Remote transport (used by start_server_sse.sh) ────────────────────
# Set MCP_TRANSPORT=sse to start an HTTP server instead of stdio.
# MCP_TRANSPORT=sse

# Network interface to bind when using SSE transport (default: 0.0.0.0)
# HOST=0.0.0.0

# TCP port to listen on when using SSE transport (default: 8000)
# PORT=8000

# ── Authentication (SSE mode only) ──────────────────────────────────────────
# Set a shared secret to require authentication on the SSE endpoint.
# Clients must pass this value via Authorization: Bearer <token> header
# or via ?token=<token> query parameter.
# When unset, no authentication is required (suitable for local / trusted use).
# MCP_AUTH_TOKEN=your-secret-token-here

# ── ngrok (Docker deployment) ───────────────────────────────────────────────
# Your ngrok authtoken — required when using the Docker image with ngrok.
# Get one free at https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your-ngrok-authtoken-here
